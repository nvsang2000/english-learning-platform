[Unit]
Description=English Learning Telegram Notification Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/nvsang/english-learning-platform
EnvironmentFile=/home/nvsang/english-learning-platform/.env.worker
Environment=PATH=/home/nvsang/.nvm/versions/node/v24.18.0/bin:/home/nvsang/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/nvsang/.nvm/versions/node/v24.18.0/bin/node /home/nvsang/english-learning-platform/dist/worker.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/nvsang/english-learning-platform /home/nvsang/.openclaw/state

[Install]
WantedBy=default.target
