{
  "name": "openclaw-english-learning",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "antigravity-gateway": "node dist/antigravity-gateway.js",
    "smoke:antigravity": "npm run build && node scripts/smoke-antigravity-gateway.mjs",
    "migrate": "node dist/migrate.js",
    "seed": "node dist/seed.js",
    "curriculum:ingest": "node dist/curriculum-ingest.js",
    "curriculum:schema": "node dist/curriculum-ingest.js --schema-only",
    "worker": "node dist/worker.js"
  },
  "dependencies": {
    "amqplib": "^0.10.8",
    "node-edge-tts": "^1.2.10",
    "pg": "^8.16.3",
    "typebox": "^1.1.39"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.7",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "openclaw": ">=2026.7.1"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.7.1",
      "minGatewayVersion": "2026.7.1"
    }
  }
}
